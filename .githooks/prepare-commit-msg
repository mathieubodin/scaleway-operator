#!/usr/bin/env bash
set -euo pipefail

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# Skip on git commit --amend
[ "${2:-}" = "commit" ] && [ -n "${3:-}" ] && exit 0

session_id=$(cat "$GIT_DIR/claude_session_id" 2>/dev/null) || exit 0
tokens_session=$(cat "$GIT_DIR/claude_tokens_session" 2>/dev/null) || exit 0
tokens_last=$(cat "$GIT_DIR/claude_tokens_last_commit" 2>/dev/null || printf '0')
carryover=$(cat "$GIT_DIR/claude_tokens_carryover" 2>/dev/null || printf '0')

[[ "$tokens_session" =~ ^[0-9]+$ ]] || tokens_session=0
[[ "$tokens_last"    =~ ^[0-9]+$ ]] || tokens_last=0
[[ "$carryover"      =~ ^[0-9]+$ ]] || carryover=0

delta=$(( tokens_session - tokens_last + carryover ))
[ "$delta" -lt 0 ] && delta=0

session_short="${session_id:0:8}"

tmpout=$(mktemp)
trap 'rm -f "$tmpout"' EXIT
injected=0

while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^Co-Authored-By: ]] && [[ $injected -eq 0 ]]; then
        printf "Claude-Session: %s\nClaude-Tokens-Delta: %d\nClaude-Tokens-Total: %d\n" \
            "$session_short" "$delta" "$tokens_session" >> "$tmpout"
        injected=1
    fi
    printf "%s\n" "$line" >> "$tmpout"
done < "$1"

if [[ $injected -eq 0 ]]; then
    printf "\nClaude-Session: %s\nClaude-Tokens-Delta: %d\nClaude-Tokens-Total: %d\n" \
        "$session_short" "$delta" "$tokens_session" >> "$tmpout"
fi

mv "$tmpout" "$1"
trap - EXIT

printf '%d' "$tokens_session" > "$GIT_DIR/claude_tokens_last_commit"
printf '0' > "$GIT_DIR/claude_tokens_carryover"
