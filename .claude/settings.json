{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowedMcpServers": [
    { "serverUrl": "https://api.anthropic.com/v1/pages/mcp" },
    { "serverCommand": ["mempalace-mcp"]}
  ],
  "model": "sonnet",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(./*)",
      "Edit(./*.md)",
      "Edit(./.release-please-manifest.json)",
      "Edit(./Dockerfile)",
      "Edit(./Makefile)",
      "Edit(./prek.toml)",
      "Edit(./release-please-config.json)",
      "Edit(./.github/*)",
      "Edit(./charts/*)",
      "Edit(./docs/*)",
      "Edit(./k8s/*)",
      "Edit(./src/*)",
      "Edit(./tests/*)",
      "Bash(make *)"
    ],
    "deny": [
      "Edit(*.claude/settings*)"
    ]
  }
}
